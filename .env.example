# Copy this file to `.env` and fill in real values.
#
# The app reads these via app.config.settings.

# Which LLM provider to use: "openai" (default) or "vertex"
LLM_PROVIDER="openai"

# OpenAI settings
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
# Timeout in seconds for each OpenAI chat call (default 60)
OPENAI_TIMEOUT_SECONDS=60

# Vertex AI settings (used when LLM_PROVIDER=vertex)
VERTEX_PROJECT="your-agentic"
VERTEX_LOCATION="your-location"
VERTEX_MODEL="your_model"

# Base directory for read_document (paths relative to this). Default empty = process cwd. Use app/docs so file_path sample.txt reads app/docs/sample.txt.
DOCS_BASE_PATH="path/to/docs"

# Optional: directory for write_document. If unset, falls back to DOCS_BASE_PATH then cwd. On Cloud Run, disk is ephemeral — use GCS/DB for durable data.
WRITES_BASE_PATH="path/to/docs/writes"

# DB (for local Docker/Postgres)
PG_HOST=your_host
PG_PORT=your_port
PG_DATABASE=your_db
PG_USER=your_user
PG_PASSWORD=
PG_SSL_MODE=